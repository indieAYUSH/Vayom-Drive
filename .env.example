# ==============================================================================
# Vayom Drive Configuration Example (.env.example)
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API Credentials (application-level, not your account login)
# Get API_ID and API_HASH from https://my.telegram.org -> API development tools
# Desktop packaging embeds only these two values into the sidecar; configure
# them before running scripts/build_sidecar.sh or the app starts in mock mode.
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ------------------------------------------------------------------------------
# 2. Telegram Bot Token
# Create a bot via https://t.me/BotFather (send /newbot command)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz_EXAMPLE

# ------------------------------------------------------------------------------
# 3. Telegram Private Storage Channel ID
# Create a private channel, add your bot as Administrator with "Post Messages" permission.
# Forward a message from the channel to @userinfobot or @JsonDumpBot to get the ID.
# Format starts with -100 (e.g., -1001234567890)
# ------------------------------------------------------------------------------
TELEGRAM_CHANNEL_ID=-1001234567890

# ------------------------------------------------------------------------------
# 4. Web Application Security & Admin Authentication
# ------------------------------------------------------------------------------
# Password used to log in to the Vayom Drive web dashboard
ADMIN_PASSWORD=change_this_to_a_strong_password

# Random 32+ character string for signing session cookies
# You can generate one via: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_this_to_a_random_secret_hex_string

# ------------------------------------------------------------------------------
# 5. Server & Storage Policy Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Directory for local database, thumbnails, and temporary upload staging
DATA_DIR=./data

# Maximum part size in bytes for chunking files > 2 GB (Default: 900 * 2 MiB = 1887436800 bytes, aligned to 2 MiB, 512 KiB, 4096 bytes)
MAX_PART_BYTES=1887436800

# Allow lossy video re-encoding (ffmpeg CRF) before splitting if video > MAX_PART_BYTES
ALLOW_LOSSY_VIDEO=false
# Never enable in production. Allows the local mock storage backend to record
# uploads while Telegram is disconnected (used only by unit tests/offline demos).
ALLOW_OFFLINE_MOCK_UPLOADS=false

# Default Storage Backend: 'telegram' (Free) | 'nas' (Pro) | 's3' (Pro) | 'nextcloud' (Pro)
DEFAULT_STORAGE_BACKEND=telegram

# ------------------------------------------------------------------------------
# 6. Multi-Storage Backends (Pro)
# ------------------------------------------------------------------------------
# Local / SMB / NFS NAS Storage Root
# Relative paths are resolved against the project in dev, but are ignored in
# packaged desktop builds (they would resolve against the launch directory,
# which may be read-only). Use an absolute path for desktop installs.
NAS_VAULT_ROOT=./data/nas_vault

# S3 / MinIO / Cloudflare R2 Storage
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_VAULT_PREFIX=vayom_vault

# Nextcloud WebDAV Storage
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_VAULT_PREFIX=vayom_vault

# ------------------------------------------------------------------------------
# 7. Pro License Key (Offline Cryptographic Verification)
# ------------------------------------------------------------------------------
VAYOM_LICENSE_KEY=
# Development mode: set to 'pro' to unlock multi-storage in local dev
VAYOM_DEV_LICENSE=

