# ==============================================================================
# Vayom Drive Configuration Example (.env.example)
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API Credentials
# Get API_ID and API_HASH from https://my.telegram.org -> API development tools
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ------------------------------------------------------------------------------
# 2. Telegram Bot Token
# Create a bot via https://t.me/BotFather (send /newbot command)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz_EXAMPLE

# ------------------------------------------------------------------------------
# 3. Telegram Private Storage Channel ID
# Create a private channel, add your bot as Administrator with "Post Messages" permission.
# Forward a message from the channel to @userinfobot or @JsonDumpBot to get the ID.
# Format starts with -100 (e.g., -1001234567890)
# ------------------------------------------------------------------------------
TELEGRAM_CHANNEL_ID=-1001234567890

# ------------------------------------------------------------------------------
# 4. Web Application Security & Admin Authentication
# ------------------------------------------------------------------------------
# Password used to log in to the Vayom Drive web dashboard
ADMIN_PASSWORD=change_this_to_a_strong_password

# Random 32+ character string for signing session cookies
# You can generate one via: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_this_to_a_random_secret_hex_string

# ------------------------------------------------------------------------------
# 5. Server & Storage Policy Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Directory for local database, thumbnails, and temporary upload staging
DATA_DIR=./data

# Maximum part size in bytes for chunking files > 2 GB (Default: 1.9 GB = 1900000000 bytes)
MAX_PART_BYTES=1900000000

# Allow lossy video re-encoding (ffmpeg CRF) before splitting if video > MAX_PART_BYTES
ALLOW_LOSSY_VIDEO=false
